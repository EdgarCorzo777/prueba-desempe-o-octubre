# ==============================================================================
# SISMoWATCH — Configuration & Environment Variables
# ==============================================================================

# Database Settings (PostgreSQL Medallion)
POSTGRES_USER=sismowatch_admin
POSTGRES_PASSWORD=sismowatch_db_pass_2026
POSTGRES_DB=sismowatch_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5434

# Medallion Database Roles & Credentials
INGESTION_USER=ingest_user
INGESTION_PASSWORD=ingest_secret_2026
TRANSFORM_USER=transform_user
TRANSFORM_PASSWORD=transform_secret_2026
API_USER=api_user
API_PASSWORD=api_secret_2026

# Airflow Settings
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqJZPo=
AIRFLOW_SECRET_KEY=sismowatch_airflow_secret_key_32bytes_min_len
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=admin_sismowatch
AIRFLOW_PORT=8088

# Lakehouse MinIO (Capa Bronze en S3)
MINIO_ROOT_USER=sismowatch_minio_admin
MINIO_ROOT_PASSWORD=sismowatch_minio_pass_2026
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=sismowatch-bronze

# API Backend Settings (FastAPI)
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET_KEY=sismowatch_jwt_secret_token_secure_key_hash_2026_xyz
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Seed Users Credentials (Seeded on first startup, NEVER hardcoded in code)
ADMIN_EMAIL=admin@sismowatch.internal
ADMIN_PASSWORD=AdminSecure2026!*
ADMIN_NAME="Administrador SismoWatch"

VIEWER_EMAIL=viewer@sismowatch.internal
VIEWER_PASSWORD=ViewerSecure2026!*
VIEWER_NAME="Operador Viewer"

# Frontend Settings (React + Vite)
WEB_PORT=3001
VITE_API_URL=http://localhost:8000

# Google Gemini AI Studio (chatbot y reportes). Obtén tu key en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Catálogo de metadatos OpenMetadata 2.0.7 (arranca con docker compose up -d).
# UI: http://localhost:8585 (admin@open-metadata.org / admin por defecto)
OPENMETADATA_CLUSTER_NAME=openmetadata
OPENMETADATA_PORT=8585
OPENMETADATA_INGESTION_PORT=8085

# Data Quality & Ingestion Thresholds
USGS_REALTIME_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
USGS_HISTORICAL_QUERY_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
DATA_FRESHNESS_THRESHOLD_MINUTES=60
MIN_EVENTS_PER_BATCH_WARNING=0
MAX_EVENTS_PER_BATCH_WARNING=5000
ALERT_WEBHOOK_URL=
